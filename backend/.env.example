# --- Optional external APIs (all signals degrade gracefully without keys) ---

# VirusTotal (recommended) - adds a reputation signal.
VIRUSTOTAL_API_KEY=
# Optional Google Safe Browsing key - replaced by OpenPhish (keyless) if absent.
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional. URLhaus works keyless by default; set only for a premium/partner key.
URLHAUS_AUTH_KEY=
# Optional ipinfo.io token. Falls back to ip-api.com and ipwho.is (keyless) if unset.
IPINFO_TOKEN=
# Optional Groq key. Without it, a rule-based summary is used.
GROQ_API_KEY=

# --- Local LLM (Ollama) - zero-cost, on-device. Fully optional. ---
# Ollama runs on the same machine by default (localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Phi-3 Mini is small and fast; llama3.2:3b is a good alternative.
OLLAMA_MODEL=phi3:mini